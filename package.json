{
  "name": "agent-or-human",
  "version": "0.6.0",
  "description": "Detect AI agent and browser automation signals for analytics and A/B testing. Live state changes, mouse, touch, pen, and keyboard. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": "./dist/agent-or-human.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ANALYTICS.md",
    "RESEARCH.md",
    "PUBLISHING.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omegdadi/session-driver.git"
  },
  "bugs": "https://github.com/omegdadi/session-driver/issues",
  "homepage": "https://omegdadi.github.io/session-driver/",
  "keywords": [
    "ai-agent-detection",
    "agent-detection",
    "human-detection",
    "browser-automation",
    "bot-detection",
    "analytics",
    "ab-testing",
    "pointer-events",
    "webdriver",
    "webmcp",
    "typescript",
    "react",
    "expo",
    "electron"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/unit.test.mjs tests/analytics.test.mjs tests/pointer.test.mjs tests/monitor.test.mjs && tsc -p tests/tsconfig.json",
    "test:browser": "playwright test",
    "test:electron": "node tests/electron.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm test && npm run test:browser && npm run test:package",
    "prepack": "npm run build",
    "test:expo": "npm run build --prefix tests/fixtures/expo && node scripts/test-expo.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "playwright test --config playwright.site.config.mjs",
    "test:inputs": "playwright test --config playwright.inputs.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
